{
    "name": "ctlab/ctlab-support",
    "version": "0.1.0",
    "description": "Base classes for CTLabs domain modules — Repository, Service, Action, DTO",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ctlab\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ctlab\\Support\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ctlab\\Support\\SupportServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
