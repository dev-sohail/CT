{
    "name": "ctlab/ctlab-support",
    "version": "0.1.0",
    "type": "library",
    "description": "DDD building blocks for the CTLabs ecosystem: base Repository, Service, Action, DTO, API Resource envelope, Policy and reusable traits.",
    "keywords": ["ctlab", "ddd", "laravel", "repository", "dto"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/collections": "^10.0|^11.0",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/pagination": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ctlab\\Support\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
