{
    "name": "@ctlab/ctlab-theme",
    "version": "0.1.0",
    "description": "Design tokens and theme system for the CTLabs ecosystem.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./tokens.css": "./dist/tokens.css",
        "./globals.css": "./dist/globals.css"
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src','dist',{recursive:true,filter:(s)=>fs.statSync(s).isDirectory()||s.endsWith('.css')})\"",
        "lint": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "typescript": "^5.4.0"
    }
}
