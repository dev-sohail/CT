{
  "name": "frame/php",
  "description": "Frame PHP - Global PHP Framework",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "delight-im/auth": "^9.0",
    "delight-im/db": "^1.5",
    "firebase/php-jwt": "^6.0",
    "guzzlehttp/guzzle": "^7.0",
    "monolog/monolog": "^3.10",
    "nikic/fast-route": "^1.3",
    "phpmailer/phpmailer": "^7.1",
    "predis/predis": "^2.0",
    "ext-mbstring": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Services\\": "brain/classes/"
    },
    "files": [
      "backend/Model.php",
      "brain/classes/QueryLogger.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "config": {
    "vendor-dir": "storage/vendor",
    "sort-packages": true
  }
}
