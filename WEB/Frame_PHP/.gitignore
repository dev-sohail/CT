# Dependencies
/node_modules/
/storage/vendor/

# Environment & secrets (contains credentials — must NOT be committed)
.ct.php
.ct
.env
.env.*
!.ct.example.php

# Build output (generated by `npm run build`)
/storage/css/app.css
/storage/js/app.js

# Caches & logs
/storage/cache/
/storage/logs/*.log

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
