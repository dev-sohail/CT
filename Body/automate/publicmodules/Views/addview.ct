<div class="container">
    <h1><?= htmlspecialchars($title ?? 'Add View') ?></h1>
    <p><?= htmlspecialchars($message ?? 'View generator functionality') ?></p>
    
    <form method="POST" action="/public/automate/addview">
        <div class="form-group">
            <label for="view_name">View Name:</label>
            <input type="text" id="view_name" name="view_name" required>
        </div>
        
        <div class="form-group">
            <label for="module_name">Module Name:</label>
            <input type="text" id="module_name" name="module_name" required>
        </div>
        
        <button type="submit">Generate View</button>
    </form>
</div>