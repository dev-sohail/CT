<div class="container">
    <h1><?= htmlspecialchars($title ?? 'Add Model') ?></h1>
    <p><?= htmlspecialchars($message ?? 'Model generator functionality') ?></p>
    
    <form method="POST" action="/public/automate/addmodels">
        <div class="form-group">
            <label for="model_name">Model Name:</label>
            <input type="text" id="model_name" name="model_name" required>
        </div>
        
        <div class="form-group">
            <label for="module_name">Module Name:</label>
            <input type="text" id="module_name" name="module_name" required>
        </div>
        
        <button type="submit">Generate Model</button>
    </form>
</div>