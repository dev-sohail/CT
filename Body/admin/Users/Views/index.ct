<div class="admin-content">
    
    <?php if (!empty($success)): ?>
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> <?= htmlspecialchars($success) ?>
        </div>
    <?php endif; ?>
    
    <?php if (!empty($error)): ?>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> <?= htmlspecialchars($error) ?>
        </div>
    <?php endif; ?>
    
    <!-- Statistics -->
    <div class="stats-grid">
        <div class="stat-card primary">
            <div class="stat-card-icon"><i class="fas fa-users"></i></div>
            <div class="stat-card-value"><?= number_format($stats['total_users'] ?? 0) ?></div>
            <div class="stat-card-label">Total Users</div>
        </div>
        <div class="stat-card success">
            <div class="stat-card-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-card-value"><?= number_format($stats['active_users'] ?? 0) ?></div>
            <div class="stat-card-label">Active Users</div>
        </div>
        <div class="stat-card warning">
            <div class="stat-card-icon"><i class="fas fa-user-shield"></i></div>
            <div class="stat-card-value"><?= number_format($stats['admin_count'] ?? 0) ?></div>
            <div class="stat-card-label">Administrators</div>
        </div>
        <div class="stat-card purple">
            <div class="stat-card-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="stat-card-value"><?= number_format($stats['student_count'] ?? 0) ?></div>
            <div class="stat-card-label">Students</div>
        </div>
    </div>
    
    <!-- Filters -->
    <div class="card">
        <form method="GET" action="/admin/users" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;align-items:end;">
            <div class="form-group" style="margin:0;">
                <label><i class="fas fa-search"></i> Search</label>
                <input type="text" name="search" class="form-control" placeholder="Name, email, username..." value="<?= htmlspecialchars($searchQuery) ?>">
            </div>
            <div class="form-group" style="margin:0;">
                <label><i class="fas fa-user-tag"></i> Role</label>
                <select name="role" class="form-control">
                    <option value="">All Roles</option>
                    <?php foreach ($roles as $role): ?>
                        <option value="<?= htmlspecialchars($role['role_slug']) ?>" <?= $roleFilter === $role['role_slug'] ? 'selected' : '' ?>>
                            <?= htmlspecialchars($role['role_name']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="form-group" style="margin:0;">
                <label><i class="fas fa-toggle-on"></i> Status</label>
                <select name="status" class="form-control">
                    <option value="">All Status</option>
                    <option value="active" <?= $statusFilter === 'active' ? 'selected' : '' ?>>Active</option>
                    <option value="inactive" <?= $statusFilter === 'inactive' ? 'selected' : '' ?>>Inactive</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filter</button>
                <a href="/admin/users" class="btn btn-secondary"><i class="fas fa-redo"></i> Reset</a>
            </div>
        </form>
    </div>
    
    <!-- Users Table -->
    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-list"></i> All Users</h3>
            <span style="color:#7f8c8d;"><?= count($users) ?> users</span>
        </div>
        
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (!empty($users)): ?>
                        <?php foreach ($users as $user): ?>
                            <tr>
                                <td><strong>#<?= $user['user_id'] ?></strong></td>
                                <td><strong><?= htmlspecialchars($user['first_name'] . ' ' . $user['last_name']) ?></strong></td>
                                <td><code><?= htmlspecialchars($user['username']) ?></code></td>
                                <td><?= htmlspecialchars($user['email']) ?></td>
                                <td><span class="badge badge-primary"><?= htmlspecialchars(ucfirst($user['role'])) ?></span></td>
                                <td>
                                    <?php if ($user['status'] === 'active'): ?>
                                        <span class="badge badge-success"><i class="fas fa-check"></i> Active</span>
                                    <?php else: ?>
                                        <span class="badge badge-danger"><i class="fas fa-times"></i> Inactive</span>
                                    <?php endif; ?>
                                </td>
                                <td><?= date('M d, Y', strtotime($user['created_at'])) ?></td>
                                <td>
                                    <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                        <a href="/admin/users/view?id=<?= $user['user_id'] ?>" class="btn btn-sm btn-secondary" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="/admin/users/edit?id=<?= $user['user_id'] ?>" class="btn btn-sm btn-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/admin/users/toggle?id=<?= $user['user_id'] ?>" class="btn btn-sm btn-warning" title="Toggle Status">
                                            <i class="fas fa-toggle-on"></i>
                                        </a>
                                        <?php if ($user['user_id'] != $_SESSION['user_id']): ?>
                                            <a href="/admin/users/delete?id=<?= $user['user_id'] ?>" class="btn btn-sm btn-danger confirm-delete" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        <?php endif; ?>
                                    </div>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <tr>
                            <td colspan="8" style="text-align:center;padding:40px;color:#7f8c8d;">
                                <i class="fas fa-inbox" style="font-size:3em;opacity:0.3;margin-bottom:15px;display:block;"></i>
                                No users found. Add your first user to get started!
                            </td>
                        </tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
    
</div>

