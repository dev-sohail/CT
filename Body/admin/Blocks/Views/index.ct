<div class="admin-content">
    <?php if (!empty($success)): ?><div class="alert alert-success"><i class="fas fa-check-circle"></i> <?= htmlspecialchars($success) ?></div><?php endif; ?>
    <?php if (!empty($error)): ?><div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <?= htmlspecialchars($error) ?></div><?php endif; ?>
    
    <div class="stats-grid">
        <div class="stat-card primary"><div class="stat-card-icon"><i class="fas fa-cube"></i></div><div class="stat-card-value"><?= $stats['total'] ?></div><div class="stat-card-label">Total Blocks</div></div>
        <div class="stat-card success"><div class="stat-card-icon"><i class="fas fa-check-circle"></i></div><div class="stat-card-value"><?= $stats['active'] ?></div><div class="stat-card-label">Active</div></div>
        <div class="stat-card warning"><div class="stat-card-icon"><i class="fas fa-times-circle"></i></div><div class="stat-card-value"><?= $stats['inactive'] ?></div><div class="stat-card-label">Inactive</div></div>
    </div>
    
    <div class="card">
        <form method="GET" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;align-items:end;">
            <div class="form-group" style="margin:0;"><label><i class="fas fa-toggle-on"></i> Status</label><select name="status" class="form-control"><option value="">All Status</option><option value="active" <?= $statusFilter === 'active' ? 'selected' : '' ?>>Active</option><option value="inactive" <?= $statusFilter === 'inactive' ? 'selected' : '' ?>>Inactive</option></select></div>
            <div class="form-group" style="margin:0;"><label><i class="fas fa-map-marker-alt"></i> Location</label><select name="location" class="form-control"><option value="">All Locations</option><option value="global" <?= $locationFilter === 'global' ? 'selected' : '' ?>>Global</option><option value="header" <?= $locationFilter === 'header' ? 'selected' : '' ?>>Header</option><option value="footer" <?= $locationFilter === 'footer' ? 'selected' : '' ?>>Footer</option><option value="sidebar" <?= $locationFilter === 'sidebar' ? 'selected' : '' ?>>Sidebar</option></select></div>
            <div><button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filter</button><a href="/admin/blocks" class="btn btn-secondary"><i class="fas fa-redo"></i> Reset</a></div>
        </form>
    </div>
    
    <div class="card">
        <div class="card-header"><h3><i class="fas fa-list"></i> All Blocks</h3><span style="color:#7f8c8d;"><?= count($blocks) ?> blocks</span></div>
        <div class="table-responsive">
            <table>
                <thead><tr><th>ID</th><th>Name</th><th>Slug</th><th>Location</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
                <tbody>
                    <?php if (!empty($blocks)): foreach ($blocks as $block): ?>
                        <tr>
                            <td><strong>#<?= $block['block_id'] ?></strong></td>
                            <td><strong><?= htmlspecialchars($block['block_name']) ?></strong></td>
                            <td><code><?= htmlspecialchars($block['block_slug']) ?></code></td>
                            <td><span class="badge badge-info"><?= htmlspecialchars($block['location']) ?></span></td>
                            <td><?= $block['status'] === 'active' ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-warning">Inactive</span>' ?></td>
                            <td><?= date('M d, Y', strtotime($block['created_at'])) ?></td>
                            <td>
                                <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                    <a href="/admin/blocks/edit?id=<?= $block['block_id'] ?>" class="btn btn-sm btn-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                    <a href="/admin/blocks/toggle?id=<?= $block['block_id'] ?>" class="btn btn-sm btn-warning" title="Toggle Status"><i class="fas fa-toggle-on"></i></a>
                                    <a href="/admin/blocks/delete?id=<?= $block['block_id'] ?>" class="btn btn-sm btn-danger confirm-delete" title="Delete"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; else: ?>
                        <tr><td colspan="7" style="text-align:center;padding:40px;color:#7f8c8d;"><i class="fas fa-inbox" style="font-size:3em;opacity:0.3;margin-bottom:15px;display:block;"></i>No blocks found. Create your first block!</td></tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

