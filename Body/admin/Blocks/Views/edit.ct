                <div class="form-group"><label><i class="fas fa-map-marker-alt"></i> Location</label><select name="location" class="form-control"><option value="global" <?= $block['location'] === 'global' ? 'selected' : '' ?>>Global</option><option value="header" <?= $block['location'] === 'header' ? 'selected' : '' ?>>Header</option><option value="footer" <?= $block['location'] === 'footer' ? 'selected' : '' ?>>Footer</option><option value="sidebar" <?= $block['location'] === 'sidebar' ? 'selected' : '' ?>>Sidebar</option><option value="content" <?= $block['location'] === 'content' ? 'selected' : '' ?>>Content</option></select></div>
                <div class="form-group"><label><i class="fas fa-toggle-on"></i> Status *</label><select name="status" class="form-control"><option value="inactive" <?= $block['status'] === 'inactive' ? 'selected' : '' ?>>Inactive</option><option value="active" <?= $block['status'] === 'active' ? 'selected' : '' ?>>Active</option></select></div>
