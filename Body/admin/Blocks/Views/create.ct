<div class="admin-topbar">
    <div class="topbar-left"><h2><i class="fas fa-plus-circle"></i> Create New Block</h2><p>Add a new reusable content block</p></div>
    <div class="topbar-right"><a href="/admin/blocks" class="topbar-btn secondary"><i class="fas fa-arrow-left"></i> Back to Blocks</a></div>
