    <div class="card">
        <div class="card-header"><h3><i class="fas fa-history"></i> Recent Activity</h3><span style="color:#7f8c8d;">Last <?= count($recentLogs) ?> requests</span></div>
        <div class="table-responsive">
            <table>
                <thead><tr><th>Timestamp</th><th>User</th><th>Prompt</th><th>Status</th><th>Response Time</th></tr></thead>
                <tbody>
                    <?php if (!empty($recentLogs)): foreach ($recentLogs as $log): ?>
                        <tr>
                            <td><?= htmlspecialchars($log['timestamp']) ?></td>
                            <td><strong><?= htmlspecialchars($log['user']) ?></strong></td>
                            <td><?= htmlspecialchars(substr($log['prompt'], 0, 50)) ?><?= strlen($log['prompt']) > 50 ? '...' : '' ?></td>
                            <td><?= ($log['success'] ?? false) ? '<span class="badge badge-success">Success</span>' : '<span class="badge badge-danger">Failed</span>' ?></td>
                            <td><?= htmlspecialchars($log['response_time'] ?? 'N/A') ?></td>
                        </tr>
                    <?php endforeach; else: ?>
                        <tr><td colspan="5" style="text-align:center;padding:40px;color:#7f8c8d;"><i class="fas fa-inbox" style="font-size:3em;opacity:0.3;margin-bottom:15px;display:block;"></i>No AI requests yet</td></tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

