                <tr><td style="padding:12px;border-top:1px solid #ecf0f1;"><strong>Provider:</strong></td><td style="padding:12px;border-top:1px solid #ecf0f1;"><code><?= htmlspecialchars($config['ai_provider']) ?></code></td></tr>
                <tr><td style="padding:12px;border-top:1px solid #ecf0f1;"><strong>Model:</strong></td><td style="padding:12px;border-top:1px solid #ecf0f1;"><code><?= htmlspecialchars($config['ai_model']) ?></code></td></tr>
                <tr><td style="padding:12px;border-top:1px solid #ecf0f1;"><strong>Max Tokens:</strong></td><td style="padding:12px;border-top:1px solid #ecf0f1;"><?= htmlspecialchars($config['max_tokens']) ?></td></tr>
