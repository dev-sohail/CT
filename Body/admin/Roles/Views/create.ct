            <h3><i class="fas fa-eye"></i> Login Button Preview</h3>
        </div>
        <div id="preview" style="text-align:center;padding:20px;">
            <button type="button" id="preview-button" 
                    style="padding:15px 30px;border:none;border-radius:8px;color:white;font-size:1.1em;font-weight:600;cursor:default;background:#667eea;">
                👤 Role Login
            </button>
        </div>
    </div>
    
