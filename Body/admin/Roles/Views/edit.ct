<script>
// Sync color inputs
const colorPicker = document.querySelector('input[type="color"]');
const colorText = document.querySelector('input[name="color_text"]');
const previewButton = document.getElementById('preview-button');

colorPicker.addEventListener('input', (e) => {
    colorText.value = e.target.value;
    updatePreview();
});

// Update preview
function updatePreview() {
    const icon = document.querySelector('input[name="icon"]').value || '👤';
    const displayName = document.querySelector('input[name="display_name"]').value || 
                        document.querySelector('input[name="role_name"]').value || 
                        'Role';
    const color = colorPicker.value;
    
    previewButton.textContent = `${icon} ${displayName}`;
    previewButton.style.background = color;
}

// Update preview on input
document.querySelectorAll('input[name="icon"], input[name="display_name"], input[name="role_name"]').forEach(input => {
    input.addEventListener('input', updatePreview);
});
</script>

