                                <?php if ($module['has_controller']): ?><span class="badge badge-primary" title="Controller">C</span> <?php endif; ?>
                                <?php if ($module['has_view']): ?><span class="badge badge-info" title="View">V</span> <?php endif; ?>
                                <?php if ($module['has_routes']): ?><span class="badge badge-warning" title="Routes">R</span> <?php endif; ?>
