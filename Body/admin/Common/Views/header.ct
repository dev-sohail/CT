        <div class="sidebar-menu-section">Framework Control</div>
        <li><a href="/admin/roles" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/roles') !== false ? 'active' : '' ?>">
            <i class="fas fa-user-shield"></i>
