        </a></li>
        <li><a href="/admin/modules" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/modules') !== false ? 'active' : '' ?>">
            <i class="fas fa-puzzle-piece"></i>
            <span>Installed Modules</span>
        </a></li>
        
        <div class="sidebar-menu-section">Content</div>
        <li><a href="/admin/public-content" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/public-content') !== false ? 'active' : '' ?>">
            <i class="fas fa-globe"></i>
            <span>Public Content</span>
        </a></li>
        <li><a href="/admin/blog" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/blog') !== false ? 'active' : '' ?>">
            <i class="fas fa-blog"></i>
            <span>Blog Posts</span>
        </a></li>
        <li><a href="/admin/media" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/media') !== false ? 'active' : '' ?>">
            <i class="fas fa-images"></i>
            <span>Media Library</span>
        </a></li>
        
        <div class="sidebar-menu-section">AI & Automation</div>
        <li><a href="/admin/ai" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/ai') !== false ? 'active' : '' ?>">
            <i class="fas fa-robot"></i>
            <span>AI Assistant</span>
        </a></li>
        <li><a href="/admin/automation" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/automation') !== false ? 'active' : '' ?>">
            <i class="fas fa-magic"></i>
            <span>Automation</span>
        </a></li>
        
        <div class="sidebar-menu-section">System</div>
        <li><a href="/admin/settings" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/settings') !== false ? 'active' : '' ?>">
            <i class="fas fa-cog"></i>
            <span>Settings</span>
        </a></li>
        <li><a href="/admin/logs" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/logs') !== false ? 'active' : '' ?>">
            <i class="fas fa-clipboard-list"></i>
            <span>System Logs</span>
        </a></li>
    </ul>
    
    <div class="sidebar-user">
        <div class="sidebar-user-info">
            <div class="sidebar-user-avatar">
                <?= strtoupper(substr($_SESSION['username'] ?? 'A', 0, 1)) ?>
            </div>
            <div class="sidebar-user-details">
                <h4><?= htmlspecialchars($_SESSION['full_name'] ?? $_SESSION['username'] ?? 'Admin User') ?></h4>
                <p><?= htmlspecialchars($_SESSION['role'] ?? 'Administrator') ?></p>
            </div>
        </div>
    </div>
</aside>

<main class="admin-main">

<script>
function toggleSidebar() {
    document.querySelector('.admin-sidebar').classList.toggle('show');
}
</script>
