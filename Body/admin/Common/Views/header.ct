        </a></li>
        
        <div class="sidebar-menu-section">Module System</div>
        <li><a href="/admin/module-generator" class="<?= strpos($_SERVER['REQUEST_URI'], '/admin/module-generator') !== false ? 'active' : '' ?>">
            <i class="fas fa-cogs"></i>
