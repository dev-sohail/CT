<div class="admin-topbar">
    <div class="topbar-left">
        <h2><i class="fas fa-file-alt"></i> Page Management</h2>
        <p>Manage website pages and content</p>
    </div>
    <div class="topbar-right">
        <a href="/admin/pages/create" class="topbar-btn"><i class="fas fa-plus"></i> Create New Page</a>
    </div>
