    <div class="card">
        <div class="card-header"><h3><i class="fas fa-tools"></i> Quick Actions</h3></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px;">
            <a href="/admin/automation/clearcache" class="btn btn-warning" style="padding:20px;text-align:center;justify-content:center;"><i class="fas fa-trash-alt"></i> Clear All Cache</a>
