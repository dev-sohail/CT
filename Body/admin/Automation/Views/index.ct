        <div class="stat-card danger"><div class="stat-card-icon"><i class="fas fa-shield-alt"></i></div><div class="stat-card-value"><?= $stats['admin'] ?></div><div class="stat-card-label">Admin Modules</div></div>
        <div class="stat-card purple"><div class="stat-card-icon"><i class="fas fa-code"></i></div><div class="stat-card-value"><?= $stats['api'] ?></div><div class="stat-card-label">API Modules</div></div>
