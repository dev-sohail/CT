    <div class="card">
        <div class="card-header"><h3><i class="fas fa-list"></i> Installed Modules</h3><span style="color:#7f8c8d;"><?= count($modules) ?> modules</span></div>
        <div class="table-responsive">
            <table>
                <thead><tr><th>Module</th><th>Type</th><th>Components</th><th>Path</th></tr></thead>
                <tbody>
                    <?php if (!empty($modules)): foreach ($modules as $module): ?>
                        <tr>
                            <td><strong><?= htmlspecialchars($module['name']) ?></strong></td>
                            <td><span class="badge badge-<?= $module['type'] === 'admin' ? 'danger' : ($module['type'] === 'public' ? 'success' : 'info') ?>"><?= htmlspecialchars($module['type']) ?></span></td>
                            <td>
                                <?php if ($module['has_controller']): ?><span class="badge badge-primary" title="Has Controller">C</span> <?php endif; ?>
                                <?php if ($module['has_model']): ?><span class="badge badge-success" title="Has Model">M</span> <?php endif; ?>
                                <?php if ($module['has_view']): ?><span class="badge badge-info" title="Has View">V</span> <?php endif; ?>
                                <?php if ($module['has_routes']): ?><span class="badge badge-warning" title="Has Routes">R</span> <?php endif; ?>
                            </td>
                            <td><code><?= htmlspecialchars($module['path']) ?></code></td>
                        </tr>
                    <?php endforeach; else: ?>
                        <tr><td colspan="4" style="text-align:center;padding:40px;color:#7f8c8d;">No modules found</td></tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

