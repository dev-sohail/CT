<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= htmlspecialchars($title ?? 'User Portal - CyberTirah') ?></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background: #f5f7fa; color: #333; }
        .user-sidebar { position: fixed; left: 0; top: 0; width: 260px; height: 100vh; background: linear-gradient(180deg, #1e3c72 0%, #2a5298 100%); color: white; overflow-y: auto; z-index: 1000; transition: transform 0.3s ease; }
        .user-sidebar::-webkit-scrollbar { width: 6px; }
        .user-sidebar::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); }
        .user-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }
        .sidebar-brand { padding: 25px 20px; background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar-brand h1 { font-size: 1.4em; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .sidebar-brand span { font-size: 0.75em; opacity: 0.7; display: block; margin-top: 5px; }
        .sidebar-menu { padding: 15px 0; list-style: none; }
        .sidebar-menu-section { padding: 15px 20px 5px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; font-weight: 600; }
        .sidebar-menu li a { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: rgba(255,255,255,0.9); text-decoration: none; transition: all 0.3s; border-left: 3px solid transparent; }
        .sidebar-menu li a:hover { background: rgba(255,255,255,0.1); border-left-color: #3498db; }
        .sidebar-menu li a.active { background: rgba(52,152,219,0.2); border-left-color: #3498db; color: white; }
        .sidebar-menu li a i { width: 20px; text-align: center; font-size: 1.1em; }
        .sidebar-user { padding: 20px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.1); margin-top: 20px; }
        .sidebar-user-info { display: flex; align-items: center; gap: 12px; }
        .sidebar-user-avatar { width: 45px; height: 45px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; font-size: 1.2em; font-weight: bold; }
        .sidebar-user-details h4 { font-size: 0.95em; margin-bottom: 3px; }
        .sidebar-user-details p { font-size: 0.8em; opacity: 0.7; }
        .user-main { margin-left: 260px; min-height: 100vh; background: #f5f7fa; }
        .user-topbar { background: white; padding: 15px 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
        .topbar-left h2 { font-size: 1.5em; color: #2c3e50; }
        .topbar-left p { color: #7f8c8d; font-size: 0.9em; margin-top: 3px; }
        .topbar-right { display: flex; gap: 15px; align-items: center; }
        .user-content { padding: 30px; max-width: 1400px; }
        .card { background: white; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 25px; margin-bottom: 25px; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #ecf0f1; }
        .card-header h3 { font-size: 1.3em; color: #2c3e50; display: flex; align-items: center; gap: 10px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 25px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); position: relative; overflow: hidden; }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; }
        .stat-card.primary::before { background: #3498db; }
        .stat-card.success::before { background: #2ecc71; }
        .stat-card.warning::before { background: #f39c12; }
        .stat-card.info::before { background: #17a2b8; }
        .stat-card-icon { width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5em; margin-bottom: 15px; }
        .stat-card.primary .stat-card-icon { background: rgba(52,152,219,0.1); color: #3498db; }
        .stat-card.success .stat-card-icon { background: rgba(46,204,113,0.1); color: #2ecc71; }
        .stat-card.warning .stat-card-icon { background: rgba(243,156,18,0.1); color: #f39c12; }
        .stat-card.info .stat-card-icon { background: rgba(23,162,184,0.1); color: #17a2b8; }
        .stat-card-value { font-size: 2em; font-weight: bold; color: #2c3e50; margin-bottom: 5px; }
        .stat-card-label { color: #7f8c8d; font-size: 0.95em; }
        .badge { padding: 4px 10px; border-radius: 12px; font-size: 0.8em; font-weight: 600; }
        .badge-primary { background: #cce5ff; color: #004085; }
        .badge-success { background: #d4edda; color: #155724; }
        .badge-warning { background: #fff3cd; color: #856404; }
        .badge-info { background: #d1ecf1; color: #0c5460; }
        .mobile-toggle { display: none; position: fixed; top: 15px; left: 15px; z-index: 1001; background: #1e3c72; color: white; padding: 10px 15px; border-radius: 6px; cursor: pointer; }
        @media (max-width: 768px) {
            .user-sidebar { transform: translateX(-100%); }
            .user-sidebar.show { transform: translateX(0); }
            .user-main { margin-left: 0; }
            .mobile-toggle { display: block; }
            .user-content { padding: 20px 15px; }
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="mobile-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></div>

<aside class="user-sidebar">
    <div class="sidebar-brand">
        <h1><i class="fas fa-graduation-cap"></i> CyberTirah</h1>
        <span><?= ucfirst($_SESSION['role'] ?? 'User') ?> Portal</span>
    </div>
    
    <ul class="sidebar-menu">
        <div class="sidebar-menu-section">Main Menu</div>
        <li><a href="/user" class="<?= $_SERVER['REQUEST_URI'] === '/user' ? 'active' : '' ?>"><i class="fas fa-home"></i><span>Dashboard</span></a></li>
        <li><a href="/user/profile" class="<?= strpos($_SERVER['REQUEST_URI'], '/user/profile') !== false ? 'active' : '' ?>"><i class="fas fa-user"></i><span>My Profile</span></a></li>
        <li><a href="/user/settings" class="<?= strpos($_SERVER['REQUEST_URI'], '/user/settings') !== false ? 'active' : '' ?>"><i class="fas fa-cog"></i><span>Settings</span></a></li>
        
        <?php if (($_SESSION['role'] ?? '') === 'student'): ?>
            <div class="sidebar-menu-section">Academic</div>
            <li><a href="/user/courses"><i class="fas fa-book"></i><span>My Courses</span></a></li>
            <li><a href="/user/assignments"><i class="fas fa-tasks"></i><span>Assignments</span></a></li>
            <li><a href="/user/grades"><i class="fas fa-chart-line"></i><span>Grades</span></a></li>
        <?php elseif (($_SESSION['role'] ?? '') === 'teacher'): ?>
            <div class="sidebar-menu-section">Teaching</div>
            <li><a href="/user/classes"><i class="fas fa-chalkboard"></i><span>My Classes</span></a></li>
            <li><a href="/user/students"><i class="fas fa-users"></i><span>Students</span></a></li>
            <li><a href="/user/grading"><i class="fas fa-pencil-alt"></i><span>Grading</span></a></li>
        <?php elseif (($_SESSION['role'] ?? '') === 'parent'): ?>
            <div class="sidebar-menu-section">Family</div>
            <li><a href="/user/children"><i class="fas fa-child"></i><span>My Children</span></a></li>
            <li><a href="/user/reports"><i class="fas fa-file-alt"></i><span>Progress Reports</span></a></li>
            <li><a href="/user/messages"><i class="fas fa-envelope"></i><span>Messages</span></a></li>
        <?php elseif (($_SESSION['role'] ?? '') === 'staff'): ?>
            <div class="sidebar-menu-section">Staff</div>
            <li><a href="/user/tasks"><i class="fas fa-clipboard-list"></i><span>Tasks</span></a></li>
            <li><a href="/user/departments"><i class="fas fa-building"></i><span>Departments</span></a></li>
            <li><a href="/user/reports"><i class="fas fa-chart-bar"></i><span>Reports</span></a></li>
        <?php endif; ?>
        
        <div class="sidebar-menu-section">Account</div>
        <li><a href="/logout"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
    </ul>
    
    <div class="sidebar-user">
        <div class="sidebar-user-info">
            <div class="sidebar-user-avatar"><?= strtoupper(substr($_SESSION['username'] ?? 'U', 0, 1)) ?></div>
            <div class="sidebar-user-details">
                <h4><?= htmlspecialchars($_SESSION['full_name'] ?? $_SESSION['username'] ?? 'User') ?></h4>
                <p><?= htmlspecialchars(ucfirst($_SESSION['role'] ?? 'User')) ?></p>
            </div>
        </div>
    </div>
</aside>

<main class="user-main">

<script>
function toggleSidebar() {
    document.querySelector('.user-sidebar').classList.toggle('show');
}
</script>

