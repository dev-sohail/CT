<div class="user-topbar">
    <div class="topbar-left">
        <h2><i class="fas fa-home"></i> Welcome, <?= htmlspecialchars($user['full_name']) ?>!</h2>
        <p><?= ucfirst($role) ?> Portal Dashboard</p>
