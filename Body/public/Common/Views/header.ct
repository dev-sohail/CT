                <?php if ($devMode): ?>
                    <li style="position:relative;">
                        <button id="routesBtn"
                            style="padding:0.5rem 1rem;border-radius:0.25rem;background:#e9ecef;border:none;cursor:pointer;transition:background 0.3s;"
                            onmouseover="this.style.background='#dee2e6'"
                            onmouseout="this.style.background='#e9ecef'">
                            Routes
                        </button>
                        <div id="routesTooltip"
                            style="display:none;position:absolute;top:100%;left:50%;transform:translateX(-50%);margin-top:0.5rem;
                            min-width:200px;background:#2d3748;color:white;font-size:0.875rem;border-radius:0.5rem;padding:0.75rem;z-index:50;box-shadow:0 4px 6px rgba(0,0,0,0.1);">
                            Loading routes...
                        </div>
                    </li>

                    <script>
                        (function() {
                            const btn = document.getElementById("routesBtn");
                            const tooltip = document.getElementById("routesTooltip");
                            let timeoutId = null;

                            btn.addEventListener("mouseenter", async () => {
                                if (!tooltip.dataset.loaded) {
                                    try {
                                        const routes = <?= json_encode(array_keys(Router::getNamedRoutes())) ?>;
                                        if (routes && routes.length > 0) {
                                            tooltip.innerHTML = '<div style="max-height:400px;overflow-y:auto;"><ul style="list-style:disc;padding-left:1.5rem;margin:0;">' +
                                                routes.map(route => `<li style="margin:0.25rem 0;">${route}</li>`).join('') +
                                                '</ul></div>';
                                        } else {
                                            tooltip.innerHTML = "No routes found.";
                                        }
                                        tooltip.dataset.loaded = "true";
                                    } catch (err) {
                                        tooltip.innerHTML = "Error loading routes.";
                                    }
                                }
                                tooltip.style.display = 'block';
                            });

                            btn.addEventListener("mouseleave", () => {
                                timeoutId = setTimeout(() => {
                                    tooltip.style.display = 'none';
                                }, 200);
                            });

                            tooltip.addEventListener("mouseenter", () => {
                                if (timeoutId) {
                                    clearTimeout(timeoutId);
                                }
                            });

                            tooltip.addEventListener("mouseleave", () => {
                                tooltip.style.display = 'none';
                            });
                        })();
                    </script>
