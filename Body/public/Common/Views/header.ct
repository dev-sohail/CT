<?php

/**
 * =============================
 * Enhanced Breadcrumb System
 * =============================
 */

if (!function_exists('toLabel')) {
    /**
     * Convert a filename or slug to a human-friendly label
     * @param string $name
     * @return string
     */
    function toLabel($name)
    {
        // Remove file extension and convert separators to spaces
        $name = pathinfo($name, PATHINFO_FILENAME);
        $name = str_replace(['-', '_'], ' ', $name);
        return ucwords($name);
    }
}

/**
 * Enhanced breadcrumb dictionary with portal mappings
 */
function getBreadcrumbDictionary()
{
    return [
        "index"     => "Home",
        "about"     => "About Us",
        "login"     => "Login",
        "register"  => "Register",
        "profile"   => "Profile",
        "students"  => "Students",
        "list"      => "List",
        "view"      => "View",
        "admin"     => "Admin",
        "dashboard" => "Dashboard",
        "logout"    => "Logout",
        "tportal"   => "Teacher Portal",
        "sportal"   => "Student Portal",
        "stportal"  => "Staff Portal",
        "pportal"   => "Parent Portal",
        "contact"   => "Contact Us",
        "services"  => "Services",
        "news"      => "News",
        "events"    => "Events",
        "team"      => "Our Team",
    ];
}

/**
 * Safely generate a URL for a named route with graceful fallback
 */
if (!function_exists('safeRouteUrl')) {
function safeRouteUrl(string $name, array $params = [], array $query = []): string
{
    try {
        if (class_exists('Router') && Router::hasRoute($name)) {
            $path = Router::url($name, $params);
            if (!empty($query)) {
                $qs = http_build_query($query);
                if ($qs !== '') {
                    $path .= (str_contains($path, '?') ? '&' : '?') . $qs;
                }
            }
            return $path;
        }
    } catch (Throwable $e) {
        // Ignore and fallback
    }
    // Reasonable fallbacks for common links
    $path = match ($name) {
        'home' => '/',
        'about' => '/about',
        'auth.login' => '/login',
        'auth.register' => '/register',
        'auth.forgot' => '/forgot-password',
        'blog.index' => '/blog',
        default => '/'
    };
    if (!empty($query)) {
        $qs = http_build_query($query);
        if ($qs !== '') {
            $path .= (str_contains($path, '?') ? '&' : '?') . $qs;
        }
    }
    return $path;
}
}

/**
 * Get current page path information
 * @return array
 */
function getCurrentPageInfo()
{
    $requestUri = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    $scriptDir = rtrim(dirname($_SERVER['SCRIPT_NAME']), '/');
    $relativePath = trim(str_replace($scriptDir, '', $requestUri), '/');

    // Handle root access
    if (empty($relativePath)) {
        $relativePath = 'index.php';
    }

    return [
        'relative_path' => $relativePath,
        'current_file' => basename($_SERVER['PHP_SELF']),
        'request_uri' => $requestUri,
        'script_dir' => $scriptDir
    ];
}

/**
 * Generate breadcrumbs automatically from URL path
 * @param string|null $currentPage
 * @return array
 */
function generateAutoBreadcrumbs($currentPage = null)
{
    $dictionary = getBreadcrumbDictionary();

    if ($currentPage === null) {
        $pageInfo = getCurrentPageInfo();
        $currentPage = $pageInfo['relative_path'];
    }

    $parts = explode("/", trim($currentPage, '/'));
    $breadcrumbs = [];
    $path = "";

    foreach ($parts as $i => $part) {
        $isLast = ($i === count($parts) - 1);

        // Get clean label
        $label = $part;
        if ($isLast && str_contains($part, ".")) {
            $label = pathinfo($part, PATHINFO_FILENAME);
        }

        // Apply dictionary mapping or convert to label
        $label = $dictionary[$label] ?? toLabel($label);

        // Build path
        $path .= ($i > 0 ? "/" : "") . $part;

        // Determine URL - use Router if available
        if ($isLast) {
            $url = ""; // Last item has no link
        } else {
            // Try to generate URL using Router
            try {
                if (class_exists('Router')) {
                    $url = '/' . $path;
                } else {
                    $url = '/' . $path;
                }
            } catch (Exception $e) {
                $url = '/' . $path;
            }
        }

        $breadcrumbs[] = [
            "label" => $label,
            "url" => $url
        ];
    }

    return $breadcrumbs;
}

/**
 * Get breadcrumbs for current page
 * @return array
 */
function getBreadcrumbs()
{
    return generateAutoBreadcrumbs();
}

/**
 * Check if breadcrumbs should be hidden (homepage only)
 * @return bool
 */
function shouldHideBreadcrumbs()
{
    $pageInfo = getCurrentPageInfo();
    $currentScript = $pageInfo['current_file'];
    $requestPath = trim($pageInfo['request_uri'], '/');

    // Hide only on true homepage
    return ($currentScript === 'index.php' && ($requestPath === '' || $requestPath === 'index.php'));
}

/**
 * Render breadcrumb HTML
 * @param array|null $breadcrumbs
 * @return void
 */
function renderBreadcrumb($breadcrumbs = null)
{
    if ($breadcrumbs === null) {
        $breadcrumbs = getBreadcrumbs();
    }

    if (empty($breadcrumbs) || shouldHideBreadcrumbs()) {
        return;
    }

    echo '<section class="breadcrumb-section" style="padding:0.5rem 0;background:#f8f9fa;border-bottom:1px solid #dee2e6;">';
    echo '<div style="max-width:1200px;margin:0 auto;padding:0 20px;">';
    echo '<nav aria-label="breadcrumb">';
    echo '<ol style="display:flex;flex-wrap:wrap;list-style:none;margin:0;padding:0;font-size:0.9em;">';

    $lastIndex = count($breadcrumbs) - 1;
    foreach ($breadcrumbs as $i => $crumb) {
        $label = htmlspecialchars($crumb['label'] ?? 'Unknown');

        if ($i !== $lastIndex && !empty($crumb['url'])) {
            $url = htmlspecialchars($crumb['url']);
            echo '<li style="display:flex;align-items:center;">';
            echo '<a href="' . $url . '" style="color:#667eea;text-decoration:none;padding:0.25rem 0.5rem;">' . $label . '</a>';
            echo '<span style="color:#6c757d;margin:0 0.25rem;">/</span>';
            echo '</li>';
        } else {
            echo '<li style="display:flex;align-items:center;color:#6c757d;padding:0.25rem 0.5rem;">' . $label . '</li>';
        }
    }

    echo '</ol>';
    echo '</nav>';
    echo '</div>';
    echo '</section>';
}

// Get current page info
$pageInfo = getCurrentPageInfo();
$currentPath = $pageInfo['request_uri'];
$devMode = defined('APP_DEBUG') && APP_DEBUG;
?>

