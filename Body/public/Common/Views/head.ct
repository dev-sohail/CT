<?php
/**
 * =============================
 * Enhanced Head Component
 * =============================
 * Provides meta tags, dynamic titles, and asset loading
 */

// ✅ Meta Tags
?>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<meta name="description" content="<?= htmlspecialchars($description ?? 'CyberTirah Framework - Modern PHP Framework') ?>">
<meta name="keywords" content="<?= htmlspecialchars($keywords ?? 'PHP, Framework, MVC, CyberTirah') ?>">
<meta name="author" content="<?= htmlspecialchars($author ?? 'CyberTirah Team') ?>">

<?php
// ✅ Asset Loader Function
if (!function_exists('load_assets')) {
    function load_assets($assets = [])
    {
        // Define available assets and their dependencies
        $available = [
            'custom' => [
                'html' => '<link rel="stylesheet" href="' . (defined('APP_STORAGE_URL') ? APP_STORAGE_URL : '/storage') . '/css/custom.css">',
                'dependencies' => []
            ],
            'tailwind' => [
                'html' => '<script src="https://cdn.tailwindcss.com"></script>',
                'dependencies' => []
            ],
            'alpine' => [
                'html' => '<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>',
                'dependencies' => []
            ],
            'fontawesome' => [
                'html' => '<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">',
                'dependencies' => []
            ],
            'jquery' => [
                'html' => '<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>',
                'dependencies' => []
            ],
            'bootstrap' => [
                'html' => '
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>',
                'dependencies' => []
            ],
            'datatable' => [
                'html' => '
                    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
                    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>',
                'dependencies' => ['jquery']
            ],
            'fullcalendar' => [
                'html' => '
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/main.min.css">
                    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>',
                'dependencies' => []
            ],
            'swiper' => [
                'html' => '
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
                    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>',
                'dependencies' => []
            ],
            'slick' => [
                'html' => '
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">
                    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>',
                'dependencies' => ['jquery']
            ],
            'chartjs' => [
                'html' => '<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>',
                'dependencies' => []
            ],
            'apexcharts' => [
                'html' => '<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>',
                'dependencies' => []
            ],
            'select2' => [
                'html' => '
                    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
                    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>',
                'dependencies' => ['jquery']
            ],
        ];

        // If "all" is specified, load all assets
        if ($assets === 'all') {
            $assets = array_keys($available);
        }

        // Track loaded assets to avoid duplicates
        $loaded = [];

        // Function to load an asset and its dependencies
        $load_asset = function ($key) use ($available, &$loaded, &$load_asset) {
            if (!isset($available[$key])) {
                if (defined('DEV_MODE') && (int)getenv('DEV_MODE') === 1) {
                    error_log("Warning: Asset '$key' not found in available assets.");
                }
                return;
            }

            // Skip if already loaded
            if (in_array($key, $loaded)) {
                return;
            }

            // Load dependencies first
            foreach ($available[$key]['dependencies'] as $dep) {
                $load_asset($dep);
            }

            // Load the asset itself
            echo $available[$key]['html'] . "\n";
            $loaded[] = $key;
        };

        // Load all requested assets
        foreach ($assets as $asset) {
            $load_asset($asset);
        }
    }
}

// ✅ Page-Specific Asset Configuration
$defaultLoad = [
    'custom' => true,
    'tailwind' => true,
    'fontawesome' => true,
];

// Merge with page-specific assets if provided
$load = isset($assets) && is_array($assets) ? array_merge($defaultLoad, $assets) : $defaultLoad;

// ✅ Dynamic Title Configuration
$defaultTitles = [
    '/' => 'Home - CyberTirah Framework',
    '/about' => 'About Us - CyberTirah Framework',
    '/blog' => 'Blog - CyberTirah Framework',
    '/login' => 'Login - CyberTirah Framework',
    '/register' => 'Register - CyberTirah Framework',
    '/contact' => 'Contact Us - CyberTirah Framework',
];

// Get current path
$currentPath = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
$currentPath = rtrim($currentPath, '/') ?: '/';

// Set title from data or default
if (!isset($title)) {
    $title = $defaultTitles[$currentPath] ?? 'CyberTirah Framework';
}
?>

<title><?php echo htmlspecialchars($title, ENT_QUOTES, 'UTF-8'); ?></title>

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="<?= defined('APP_STORAGE_URL') ? APP_STORAGE_URL : '/storage' ?>/images/favicon.ico">

<?php
// ✅ Load assets based on configuration
if (isset($loadAll) && $loadAll === true) {
    load_assets('all');
} else {
    load_assets(array_keys(array_filter($load)));
}
?>

