<div class="blog-post-page" style="max-width:900px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    
    <?php if (!empty($post)): ?>
        <article style="background:white;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,0.1);overflow:hidden;margin-bottom:40px;">
            
            <!-- Post Header -->
            <div style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:80px 40px;text-align:center;">
                <div style="font-size:5em;margin-bottom:20px;">
                    <?= $post['image'] ?? '📝' ?>
                </div>
                
                <!-- Category Badge -->
                <div style="margin-bottom:20px;">
                    <span style="display:inline-block;padding:8px 16px;background:rgba(255,255,255,0.2);color:white;border-radius:20px;font-size:0.85em;text-transform:uppercase;font-weight:600;">
                        <?= htmlspecialchars($post['category'] ?? 'General') ?>
                    </span>
                </div>
                
                <!-- Title -->
                <h1 style="font-size:2.5em;color:white;margin-bottom:20px;line-height:1.3;">
                    <?= htmlspecialchars($post['title']) ?>
                </h1>
                
                <!-- Meta -->
                <div style="color:rgba(255,255,255,0.9);font-size:1em;">
                    <span>By <?= htmlspecialchars($post['author'] ?? 'Unknown') ?></span>
                    <span style="margin:0 10px;">•</span>
                    <span><?= date('F j, Y', strtotime($post['published_at'] ?? 'now')) ?></span>
                </div>
            </div>
            
            <!-- Post Content -->
            <div style="padding:40px;">
                <!-- Excerpt -->
                <?php if (!empty($post['excerpt'])): ?>
                    <div style="font-size:1.2em;color:#6c757d;margin-bottom:30px;padding:20px;background:#f8f9fa;border-left:4px solid #667eea;border-radius:5px;">
                        <?= htmlspecialchars($post['excerpt']) ?>
                    </div>
                <?php endif; ?>
                
                <!-- Main Content -->
                <div style="font-size:1.1em;line-height:1.8;color:#333;">
                    <?= nl2br(htmlspecialchars($post['content'])) ?>
                </div>
                
                <!-- Tags (if available) -->
                <?php if (!empty($post['tags'])): ?>
                    <div style="margin-top:40px;padding-top:30px;border-top:1px solid #e9ecef;">
                        <h3 style="font-size:1.1em;margin-bottom:15px;color:#333;">Tags:</h3>
                        <div style="display:flex;gap:10px;flex-wrap:wrap;">
                            <?php foreach ($post['tags'] as $tag): ?>
                                <span style="padding:5px 12px;background:#e9ecef;color:#333;border-radius:20px;font-size:0.85em;">
                                    #<?= htmlspecialchars($tag) ?>
                                </span>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endif; ?>
            </div>
            
        </article>

        <!-- Navigation -->
        <div style="margin-bottom:40px;text-align:center;">
            <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.index') : '/blog' ?>" 
               style="display:inline-block;padding:12px 30px;background:#667eea;color:white;text-decoration:none;border-radius:5px;font-weight:600;transition:background 0.3s;"
               onmouseover="this.style.background='#5568d3'"
               onmouseout="this.style.background='#667eea'">
                ← Back to Blog
            </a>
        </div>

        <!-- Related Posts -->
        <?php if (!empty($related_posts)): ?>
            <div style="margin-top:60px;">
                <h2 style="font-size:2em;margin-bottom:30px;text-align:center;color:#333;">Related Articles</h2>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
                    <?php foreach ($related_posts as $related): ?>
                        <div style="background:white;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,0.1);padding:20px;">
                            <div style="font-size:2.5em;margin-bottom:10px;text-align:center;">
                                <?= $related['image'] ?? '📝' ?>
                            </div>
                            <h3 style="font-size:1.2em;margin-bottom:10px;">
                                <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.show', ['id' => $related['id']]) : '/blog/' . (int)$related['id'] ?>" 
                                   style="color:#333;text-decoration:none;"
                                   onmouseover="this.style.color='#667eea'"
                                   onmouseout="this.style.color='#333'">
                                    <?= htmlspecialchars($related['title']) ?>
                                </a>
                            </h3>
                            <p style="font-size:0.9em;color:#6c757d;">
                                <?= substr(htmlspecialchars($related['excerpt']), 0, 100) . '...' ?>
                            </p>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endif; ?>

    <?php else: ?>
        <div style="text-align:center;padding:80px 20px;">
            <h2 style="font-size:2em;margin-bottom:15px;color:#333;">Post Not Found</h2>
            <p style="font-size:1.1em;color:#6c757d;margin-bottom:30px;">The post you're looking for doesn't exist.</p>
            <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.index') : '/blog' ?>" 
               style="display:inline-block;padding:12px 30px;background:#667eea;color:white;text-decoration:none;border-radius:5px;font-weight:600;">
                View All Posts
            </a>
        </div>
    <?php endif; ?>

</div>

