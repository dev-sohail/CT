<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= htmlspecialchars($blog['title']) ?> - CyberTirah Framework</title>
    <meta name="description" content="<?= htmlspecialchars($blog['meta_description'] ?? $blog['excerpt'] ?? '') ?>">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background: #2c3e50;
            color: white;
            padding: 20px 0;
            margin-bottom: 30px;
        }
        .header a {
            color: white;
            text-decoration: none;
            font-weight: 500;
        }
        .header a:hover {
            color: #3498db;
        }
        .blog-post {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }
        .blog-image {
            width: 100%;
            height: 300px;
            background: #ecf0f1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #7f8c8d;
            font-size: 3rem;
        }
        .blog-content {
            padding: 40px;
        }
        .blog-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 20px 0;
            color: #2c3e50;
            line-height: 1.2;
        }
        .blog-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #ecf0f1;
            flex-wrap: wrap;
            gap: 10px;
        }
        .blog-date {
            color: #7f8c8d;
            font-size: 0.9rem;
        }
        .blog-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .tag {
            background: #ecf0f1;
            color: #2c3e50;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.8rem;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .tag:hover {
            background: #3498db;
            color: white;
        }
        .blog-body {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #2c3e50;
        }
        .blog-body h1, .blog-body h2, .blog-body h3 {
            color: #2c3e50;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        .blog-body p {
            margin-bottom: 20px;
        }
        .blog-body ul, .blog-body ol {
            margin-bottom: 20px;
            padding-left: 30px;
        }
        .blog-body blockquote {
            border-left: 4px solid #3498db;
            padding-left: 20px;
            margin: 20px 0;
            font-style: italic;
            color: #7f8c8d;
        }
        .related-posts {
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 30px;
        }
        .related-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 0 20px 0;
            color: #2c3e50;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        .related-item {
            border: 1px solid #ecf0f1;
            border-radius: 6px;
            padding: 20px;
            transition: all 0.3s ease;
        }
        .related-item:hover {
            border-color: #3498db;
            transform: translateY(-2px);
        }
        .related-item h4 {
            margin: 0 0 10px 0;
            font-size: 1.1rem;
        }
        .related-item h4 a {
            color: #2c3e50;
            text-decoration: none;
        }
        .related-item h4 a:hover {
            color: #3498db;
        }
        .related-item p {
            color: #7f8c8d;
            font-size: 0.9rem;
            margin: 0;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
        }
        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="container">
            <a href="/blog">&larr; Back to Blog</a>
        </div>
    </div>

    <div class="container">
        <article class="blog-post">
            <?php if (!empty($blog['featured_image'])): ?>
                <div class="blog-image" style="background-image: url('<?= htmlspecialchars($blog['featured_image']) ?>'); background-size: cover; background-position: center;"></div>
            <?php else: ?>
                <div class="blog-image">📝</div>
            <?php endif; ?>
            
            <div class="blog-content">
                <h1 class="blog-title"><?= htmlspecialchars($blog['title']) ?></h1>
                
                <div class="blog-meta">
                    <span class="blog-date">
                        Published on <?= date('F j, Y', strtotime($blog['created_at'])) ?>
                    </span>
                    
                    <?php if (!empty($blog['tags'])): ?>
                        <div class="blog-tags">
                            <?php 
                            $tags = explode(',', $blog['tags']);
                            foreach ($tags as $tag): 
                            ?>
                                <a href="/blog?tag=<?= urlencode(trim($tag)) ?>" class="tag">
                                    <?= htmlspecialchars(trim($tag)) ?>
                                </a>
                            <?php endforeach; ?>
                        </div>
                    <?php endif; ?>
                </div>
                
                <div class="blog-body">
                    <?= nl2br(htmlspecialchars($blog['content'])) ?>
                </div>
            </div>
        </article>

        <!-- Related Posts -->
        <?php if (isset($related) && !empty($related)): ?>
            <div class="related-posts">
                <h3 class="related-title">Related Posts</h3>
                <div class="related-grid">
                    <?php foreach ($related as $relatedPost): ?>
                        <div class="related-item">
                            <h4>
                                <a href="/blog/<?= htmlspecialchars($relatedPost['slug']) ?>">
                                    <?= htmlspecialchars($relatedPost['title']) ?>
                                </a>
                            </h4>
                            <?php if (!empty($relatedPost['excerpt'])): ?>
                                <p><?= htmlspecialchars(substr($relatedPost['excerpt'], 0, 100)) ?>...</p>
                            <?php endif; ?>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endif; ?>
    </div>
</body>
</html>
