<div class="blog-page" style="max-width:1200px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    
    <!-- Page Header -->
    <div style="text-align:center;padding:40px 20px 60px;">
        <h1 style="font-size:3em;margin-bottom:15px;color:#333;"><?= htmlspecialchars($heading ?? 'Blog') ?></h1>
        <p style="font-size:1.2em;color:#6c757d;max-width:600px;margin:0 auto;">
            Latest news, tutorials, and insights about CyberTirah Framework
        </p>
    </div>

    <!-- Blog Posts Grid -->
    <?php if (!empty($posts)): ?>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:30px;margin-bottom:60px;">
            <?php foreach ($posts as $post): ?>
                <article style="background:white;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,0.1);overflow:hidden;transition:transform 0.3s;"
                         onmouseover="this.style.transform='translateY(-5px)'"
                         onmouseout="this.style.transform='translateY(0)'">
                    
                    <!-- Post Image/Icon -->
                    <div style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:60px;text-align:center;font-size:4em;">
                        <?= $post['image'] ?? '📝' ?>
                    </div>
                    
                    <!-- Post Content -->
                    <div style="padding:25px;">
                        <!-- Category Badge -->
                        <div style="margin-bottom:15px;">
                            <span style="display:inline-block;padding:5px 12px;background:#667eea;color:white;border-radius:20px;font-size:0.75em;text-transform:uppercase;font-weight:600;">
                                <?= htmlspecialchars($post['category'] ?? 'General') ?>
                            </span>
                        </div>
                        
                        <!-- Title -->
                        <h2 style="font-size:1.5em;margin-bottom:15px;color:#333;line-height:1.3;">
                            <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.show', ['id' => $post['id']]) : '/blog/' . (int)$post['id'] ?>" 
                               style="color:inherit;text-decoration:none;"
                               onmouseover="this.style.color='#667eea'"
                               onmouseout="this.style.color='#333'">
                                <?= htmlspecialchars($post['title']) ?>
                            </a>
                        </h2>
                        
                        <!-- Excerpt -->
                        <p style="color:#6c757d;line-height:1.6;margin-bottom:20px;font-size:0.95em;">
                            <?= htmlspecialchars($post['excerpt']) ?>
                        </p>
                        
                        <!-- Meta -->
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-top:15px;border-top:1px solid #e9ecef;font-size:0.85em;color:#6c757d;">
                            <span>By <?= htmlspecialchars($post['author'] ?? 'Unknown') ?></span>
                            <span><?= date('M j, Y', strtotime($post['published_at'] ?? 'now')) ?></span>
                        </div>
                        
                        <!-- Read More Link -->
                        <div style="margin-top:15px;">
                            <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.show', ['id' => $post['id']]) : '/blog/' . (int)$post['id'] ?>" 
                               style="color:#667eea;text-decoration:none;font-weight:600;display:inline-flex;align-items:center;gap:5px;"
                               onmouseover="this.style.color='#5568d3'"
                               onmouseout="this.style.color='#667eea'">
                                Read More →
                            </a>
                        </div>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>

        <!-- Pagination -->
        <?php if (isset($total_pages) && $total_pages > 1): ?>
            <div style="display:flex;justify-content:center;gap:10px;padding:40px 0;">
                <?php for ($i = 1; $i <= $total_pages; $i++): ?>
                    <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('blog.index', [], ['page' => $i]) : '/blog?page=' . (int)$i ?>" 
                       style="display:inline-block;padding:10px 15px;<?= ($current_page ?? 1) === $i ? 'background:#667eea;color:white;' : 'background:#e9ecef;color:#333;' ?>border-radius:5px;text-decoration:none;transition:background 0.3s;"
                       onmouseover="if(this.style.background !== 'rgb(102, 126, 234)') this.style.background='#dee2e6'"
                       onmouseout="if(this.style.background !== 'rgb(102, 126, 234)') this.style.background='#e9ecef'">
                        <?= $i ?>
                    </a>
                <?php endfor; ?>
            </div>
        <?php endif; ?>

    <?php else: ?>
        <div style="text-align:center;padding:80px 20px;">
            <div style="font-size:4em;margin-bottom:20px;">📝</div>
            <h2 style="font-size:2em;margin-bottom:15px;color:#333;">No Posts Found</h2>
            <p style="font-size:1.1em;color:#6c757d;">Check back soon for new articles and tutorials!</p>
        </div>
    <?php endif; ?>

</div>

