<div class="auth-page" style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    
    <div class="auth-container" style="max-width:500px;width:100%;background:white;border-radius:15px;box-shadow:0 10px 40px rgba(0,0,0,0.1);padding:40px;">
        
        <!-- Logo/Header -->
        <div style="text-align:center;margin-bottom:30px;">
            <h1 style="font-size:2.5em;margin-bottom:10px;color:#667eea;">🔐</h1>
            <h2 style="font-size:1.8em;margin-bottom:10px;color:#333;">Login</h2>
            <p style="color:#6c757d;">Access your account</p>
        </div>

        <!-- Error/Success Messages -->
        <?php if (!empty($error)): ?>
            <div style="padding:15px;background:#f8d7da;border:1px solid #f5c2c7;border-radius:8px;margin-bottom:20px;color:#842029;">
                <strong>❌ Error:</strong> <?= htmlspecialchars($error) ?>
            </div>
        <?php endif; ?>
        
        <?php if (!empty($success)): ?>
            <div style="padding:15px;background:#d1e7dd;border:1px solid #badbcc;border-radius:8px;margin-bottom:20px;color:#0f5132;">
                <strong>✅ Success:</strong> <?= htmlspecialchars($success) ?>
            </div>
        <?php endif; ?>

        <?php if (!$selectedRole): ?>
            <!-- Role Selection -->
            <div style="text-align:center;margin-bottom:20px;">
                <p style="font-size:1.1em;color:#6c757d;margin-bottom:25px;">Select your role to continue:</p>
            </div>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.login') : '/login' ?>" style="display:grid;gap:15px;">
                <?php if (!empty($roles)): ?>
                    <?php foreach ($roles as $role): ?>
                        <?php
                            $roleSlug = htmlspecialchars($role['role_slug']);
                            $displayName = htmlspecialchars($role['display_name']);
                            $icon = htmlspecialchars($role['icon'] ?? '👤');
                            $color = htmlspecialchars($role['color'] ?? '#667eea');
                            
                            // Calculate hover color (slightly darker)
                            $hoverColor = $color;
                            if (preg_match('/^#([0-9a-f]{6})$/i', $color, $matches)) {
                                $r = hexdec(substr($color, 1, 2));
                                $g = hexdec(substr($color, 3, 2));
                                $b = hexdec(substr($color, 5, 2));
                                $hoverColor = sprintf('#%02x%02x%02x', max(0, $r - 20), max(0, $g - 20), max(0, $b - 20));
                            }
                            
                            // Text color based on background brightness
                            $textColor = ($color === '#ffc107') ? '#333' : 'white';
                        ?>
                        <button type="submit" name="role" value="<?= $roleSlug ?>" 
                                style="padding:15px;border:none;border-radius:8px;background:<?= $color ?>;color:<?= $textColor ?>;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                                onmouseover="this.style.background='<?= $hoverColor ?>'" 
                                onmouseout="this.style.background='<?= $color ?>'">
                            <?= $icon ?> <?= $displayName ?>
                        </button>
                    <?php endforeach; ?>
                <?php else: ?>
                    <p style="text-align:center;color:#dc3545;">No roles available. Please contact support.</p>
                <?php endif; ?>
            </form>

        <?php else: ?>
            <!-- Login Form -->
            <div style="text-align:center;margin-bottom:25px;padding:15px;background:#f8f9fa;border-radius:8px;">
                <p style="font-size:1.1em;color:#333;">
                    Logging in as <strong style="color:#667eea;"><?= htmlspecialchars(ucfirst($selectedRole)) ?></strong>
                </p>
            </div>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.login') : '/login' ?>">
                <input type="hidden" name="role" value="<?= htmlspecialchars($selectedRole) ?>">
                
                <div style="margin-bottom:20px;">
                    <label for="username" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                        Username or Email:
                    </label>
                    <input type="text" id="username" name="username" required 
                           style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;transition:border-color 0.3s;"
                           onfocus="this.style.borderColor='#667eea'" onblur="this.style.borderColor='#e9ecef'"
                           placeholder="Enter your username or email">
                </div>
                
                <div style="margin-bottom:20px;">
                    <label for="password" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                        Password:
                    </label>
                    <input type="password" id="password" name="password" required 
                           style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;transition:border-color 0.3s;"
                           onfocus="this.style.borderColor='#667eea'" onblur="this.style.borderColor='#e9ecef'"
                           placeholder="Enter your password">
                </div>
                
                <div style="text-align:right;margin-bottom:20px;">
                    <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.forgot') : '/forgot-password' ?>" style="color:#667eea;font-size:0.9em;transition:color 0.3s;"
                       onmouseover="this.style.color='#5568d3'" onmouseout="this.style.color='#667eea'">
                        Forgot Password?
                    </a>
                </div>
                
                <button type="submit" 
                        style="width:100%;padding:15px;border:none;border-radius:8px;background:#667eea;color:white;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;margin-bottom:15px;"
                        onmouseover="this.style.background='#5568d3'" onmouseout="this.style.background='#667eea'">
                    🔓 Login
                </button>
            </form>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.login') : '/login' ?>">
                <button type="submit" name="reset" 
                        style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;background:white;color:#333;font-size:1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.borderColor='#667eea';this.style.color='#667eea'" onmouseout="this.style.borderColor='#e9ecef';this.style.color='#333'">
                    ← Back to Role Selection
                </button>
            </form>
        <?php endif; ?>

        <!-- Register Link -->
        <div style="text-align:center;margin-top:30px;padding-top:20px;border-top:1px solid #e9ecef;">
            <p style="color:#6c757d;">
                Don't have an account? 
                <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.register') : '/register' ?>" style="color:#667eea;font-weight:600;transition:color 0.3s;"
                   onmouseover="this.style.color='#5568d3'" onmouseout="this.style.color='#667eea'">
                    Register here
                </a>
            </p>
        </div>

    </div>

</div>

