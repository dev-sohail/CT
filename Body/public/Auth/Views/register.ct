<div class="auth-page" style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    
    <div class="auth-container" style="max-width:550px;width:100%;background:white;border-radius:15px;box-shadow:0 10px 40px rgba(0,0,0,0.1);padding:40px;">
        
        <!-- Logo/Header -->
        <div style="text-align:center;margin-bottom:30px;">
            <h1 style="font-size:2.5em;margin-bottom:10px;color:#667eea;">📝</h1>
            <h2 style="font-size:1.8em;margin-bottom:10px;color:#333;">Register</h2>
            <p style="color:#6c757d;">Create your account</p>
        </div>

        <!-- Error/Success Messages -->
        <?php if (!empty($error)): ?>
            <div style="padding:15px;background:#f8d7da;border:1px solid #f5c2c7;border-radius:8px;margin-bottom:20px;color:#842029;">
                <strong>❌ Error:</strong> <?= htmlspecialchars($error) ?>
            </div>
        <?php endif; ?>
        
        <?php if (!empty($success)): ?>
            <div style="padding:15px;background:#d1e7dd;border:1px solid #badbcc;border-radius:8px;margin-bottom:20px;color:#0f5132;">
                <strong>✅ Success:</strong> <?= htmlspecialchars($success) ?>
            </div>
        <?php endif; ?>

        <?php if (!$selectedRole): ?>
            <!-- Role Selection -->
            <div style="text-align:center;margin-bottom:20px;">
                <p style="font-size:1.1em;color:#6c757d;margin-bottom:25px;">Select your role to register:</p>
            </div>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.register') : '/register' ?>" style="display:grid;gap:15px;">
                <button type="submit" name="role" value="student" 
                        style="padding:15px;border:none;border-radius:8px;background:#667eea;color:white;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.background='#5568d3'" onmouseout="this.style.background='#667eea'">
                    👨‍🎓 Register as Student
                </button>
                
                <button type="submit" name="role" value="teacher" 
                        style="padding:15px;border:none;border-radius:8px;background:#764ba2;color:white;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.background='#663a8e'" onmouseout="this.style.background='#764ba2'">
                    👨‍🏫 Register as Teacher
                </button>
                
                <button type="submit" name="role" value="parent" 
                        style="padding:15px;border:none;border-radius:8px;background:#28a745;color:white;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.background='#218838'" onmouseout="this.style.background='#28a745'">
                    👪 Register as Parent
                </button>
                
                <button type="submit" name="role" value="staff" 
                        style="padding:15px;border:none;border-radius:8px;background:#ffc107;color:#333;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.background='#e0a800'" onmouseout="this.style.background='#ffc107'">
                    👔 Register as Staff
                </button>
            </form>

        <?php else: ?>
            <!-- Registration Form -->
            <div style="text-align:center;margin-bottom:25px;padding:15px;background:#f8f9fa;border-radius:8px;">
                <p style="font-size:1.1em;color:#333;">
                    Registering as <strong style="color:#667eea;"><?= htmlspecialchars(ucfirst($selectedRole)) ?></strong>
                </p>
            </div>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.register') : '/register' ?>">
                <input type="hidden" name="role" value="<?= htmlspecialchars($selectedRole) ?>">
                
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:20px;">
                    <div>
                        <label for="first_name" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                            First Name: <span style="color:#dc3545;">*</span>
                        </label>
                        <input type="text" id="first_name" name="first_name" required 
                               style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;"
                               placeholder="John">
                    </div>
                    
                    <div>
                        <label for="last_name" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                            Last Name: <span style="color:#dc3545;">*</span>
                        </label>
                        <input type="text" id="last_name" name="last_name" required 
                               style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;"
                               placeholder="Doe">
                    </div>
                </div>
                
                <div style="margin-bottom:20px;">
                    <label for="email" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                        Email: <span style="color:#dc3545;">*</span>
                    </label>
                    <input type="email" id="email" name="email" required 
                           style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;"
                           placeholder="john.doe@example.com">
                </div>
                
                <div style="margin-bottom:20px;">
                    <label for="phone" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                        Phone Number:
                    </label>
                    <input type="tel" id="phone" name="phone" pattern="^\+?[0-9]{7,15}$" 
                           style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;"
                           placeholder="+1234567890">
                    <small style="color:#6c757d;font-size:0.85em;">Optional. Format: +1234567890</small>
                </div>
                
                <div style="margin-bottom:20px;">
                    <label for="password" style="display:block;margin-bottom:8px;font-weight:600;color:#333;">
                        Password: <span style="color:#dc3545;">*</span>
                    </label>
                    <input type="password" id="password" name="password" required minlength="6"
                           style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;font-size:1em;"
                           placeholder="At least 6 characters">
                    <small style="color:#6c757d;font-size:0.85em;">Minimum 6 characters</small>
                </div>
                
                <button type="submit" 
                        style="width:100%;padding:15px;border:none;border-radius:8px;background:#667eea;color:white;font-size:1.1em;font-weight:600;cursor:pointer;transition:all 0.3s;margin-bottom:15px;"
                        onmouseover="this.style.background='#5568d3'" onmouseout="this.style.background='#667eea'">
                    ✨ Create Account
                </button>
            </form>
            
            <form method="post" action="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.register') : '/register' ?>">
                <button type="submit" name="reset" 
                        style="width:100%;padding:12px;border:2px solid #e9ecef;border-radius:8px;background:white;color:#333;font-size:1em;font-weight:600;cursor:pointer;transition:all 0.3s;"
                        onmouseover="this.style.borderColor='#667eea';this.style.color='#667eea'" onmouseout="this.style.borderColor='#e9ecef';this.style.color='#333'">
                    ← Back to Role Selection
                </button>
            </form>
        <?php endif; ?>

        <!-- Login Link -->
        <div style="text-align:center;margin-top:30px;padding-top:20px;border-top:1px solid #e9ecef;">
            <p style="color:#6c757d;">
                Already have an account? 
                <a href="<?= function_exists('safeRouteUrl') ? safeRouteUrl('auth.login') : '/login' ?>" style="color:#667eea;font-weight:600;transition:color 0.3s;"
                   onmouseover="this.style.color='#5568d3'" onmouseout="this.style.color='#667eea'">
                    Login here
                </a>
            </p>
        </div>

    </div>

</div>

